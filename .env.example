# Public/client configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server/automation secrets. Never commit real values.
# Required only by scripts/ingest-catalog.mjs for LIVE runs: it writes to a
# table whose RLS exposes SELECT only, so the publishable key cannot insert.
# A dry run does not need this. Supabase dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace-me
OPENROUTER_API_KEY=replace-with-openrouter-key
INDEXNOW_KEY=replace-with-indexnow-key
GSC_CLIENT_EMAIL=service-account@example.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
