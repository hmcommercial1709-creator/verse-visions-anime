<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>صراع الجزر: الأنمي السيبراني المتقدم | Game Castle</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800;900&display=swap');
        body { font-family: 'Cairo', sans-serif; background-color: #030712; color: #22d3ee; overflow-x: hidden; }
        .cyber-grid {
            background-image: radial-gradient(rgba(6, 182, 212, 0.15) 1px, transparent 1px);
            background-size: 24px 24px;
        }
        .neon-glow { box-shadow: 0 0 25px rgba(6, 182, 212, 0.35); }
        .neon-border { border: 1px solid rgba(6, 182, 212, 0.4); }
        .radar-line { animation: sweep 3s linear infinite; transform-origin: center; }
        @keyframes sweep { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .pulse-slow { animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
    </style>
</head>
<body class="min-h-screen cyber-grid flex flex-col p-4 md:p-6 gap-6">

    <!-- Top Status Bar -->
    <header class="flex flex-wrap justify-between items-center bg-[#090D16]/95 neon-border p-4 rounded-2xl shadow-2xl backdrop-blur-xl">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/10 neon-border flex items-center justify-center animate-pulse">
                <i data-lucide="shield-alert" class="w-6 h-6 text-cyan-400"></i>
            </div>
            <div>
                <h1 class="text-base font-black tracking-wider text-white">صراع الجزر: الميناء السيبراني</h1>
                <p class="text-xs text-cyan-400/70">Game Castle Tactical Core v7.0</p>
            </div>
        </div>
        <div class="flex items-center gap-4 mt-2 sm:mt-0">
            <div class="bg-black/60 neon-border px-4 py-2 rounded-xl flex items-center gap-2.5 shadow-inner">
                <i data-lucide="gem" class="w-4 h-4 text-purple-400 animate-bounce"></i>
                <span id="gem-count" class="text-white font-black text-sm">3,500</span>
            </div>
            <div class="bg-black/60 neon-border px-4 py-2 rounded-xl flex items-center gap-2.5 shadow-inner">
                <i data-lucide="zap" class="w-4 h-4 text-yellow-400"></i>
                <span id="flux-count" class="text-white font-black text-sm">1,500</span>
            </div>
            <button onclick="toggleAudio()" id="audio-btn" class="p-2.5 bg-cyan-500/10 hover:bg-cyan-500/20 neon-border rounded-xl transition">
                <i data-lucide="volume-2" class="w-5 h-5 text-cyan-400"></i>
            </button>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="flex gap-3 overflow-x-auto pb-1">
        <button onclick="switchTab('game')" id="tab-game" class="px-5 py-2.5 rounded-xl font-bold text-xs bg-cyan-500 text-black shadow-lg shadow-cyan-500/20 transition flex items-center gap-2">
            <i data-lucide="crosshair" class="w-4 h-4"></i> ساحة المعركة والتحكم
        </button>
        <button onclick="switchTab('upgrades')" id="tab-upgrades" class="px-5 py-2.5 rounded-xl font-bold text-xs bg-[#090D16] text-cyan-400 neon-border hover:bg-cyan-500/10 transition flex items-center gap-2">
            <i data-lucide="cpu" class="w-4 h-4"></i> ترقية الدفاعات والبناء
        </button>
        <button onclick="switchTab('store')" id="tab-store" class="px-5 py-2.5 rounded-xl font-bold text-xs bg-[#090D16] text-purple-400 border border-purple-500/40 hover:bg-purple-500/10 transition flex items-center gap-2">
            <i data-lucide="gem" class="w-4 h-4"></i> متجر الجواهر الفوري
        </button>
    </nav>

    <!-- Main Content Grid -->
    <main class="flex-1 grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Center Arena (Island View) -->
        <section id="view-game" class="lg:col-span-8 flex flex-col gap-6">
            <div class="bg-[#060A13] neon-border rounded-3xl p-6 relative min-h-[440px] flex flex-col justify-between overflow-hidden neon-glow">
                <!-- Cyberpunk Radar Background Grid -->
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-20">
                    <div class="w-[450px] h-[450px] border border-cyan-500/30 rounded-full absolute"></div>
                    <div class="w-[280px] h-[280px] border border-cyan-500/30 rounded-full absolute"></div>
                    <div class="w-[450px] h-[450px] border-r-2 border-cyan-400 rounded-full radar-line absolute"></div>
                </div>

                <!-- Wave Header Status -->
                <div class="flex justify-between items-center z-10 bg-red-950/40 border border-red-500/30 px-4 py-2 rounded-xl backdrop-blur-md">
                    <span class="text-xs text-red-400 font-bold flex items-center gap-2">
                        <i data-lucide="flame" class="w-4 h-4 animate-bounce"></i> حالة الهجوم: الأسطول المعادي يقترب
                    </span>
                    <span class="text-xs bg-red-500/20 text-red-300 px-3 py-1 rounded-lg font-black animate-pulse">موجة تكتيكية #3</span>
                </div>

                <!-- Central Island Visual Artwork -->
                <div class="my-auto py-6 flex flex-col items-center justify-center relative z-10">
                    <div class="w-48 h-48 rounded-full bg-gradient-to-b from-cyan-500/20 via-blue-600/30 to-purple-600/20 border-2 border-cyan-400/80 flex items-center justify-center relative shadow-[0_0_60px_rgba(6,182,212,0.3)]">
                        <div class="w-32 h-32 rounded-full bg-cyan-400/10 pulse-slow absolute"></div>
                        <i data-lucide="shield-check" class="w-20 h-20 text-cyan-300 drop-shadow-[0_0_15px_rgba(6,182,212,0.8)]"></i>
                    </div>
                    <div class="mt-4 text-center">
                        <h2 class="text-white font-black tracking-widest text-sm">قلعة الميناء السيبرانية المركزية</h2>
                        <p class="text-xs text-cyan-400/70 mt-1">درع الأمان نشط والموارد قيد التوليد</p>
                    </div>
                </div>

                <!-- Quick Action Footer Inside Arena -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 z-10">
                    <button onclick="triggerStrike('VLS Cruise Missile')" class="bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-bold py-3 px-4 rounded-xl text-xs transition shadow-lg flex items-center justify-center gap-2 active:scale-95">
                        <i data-lucide="zap" class="w-4 h-4"></i> إطلاق صواريخ كروز (150 فلكس)
                    </button>
                    <button onclick="switchTab('store')" class="bg-purple-600 hover:bg-purple-500 text-white font-bold py-3 px-4 rounded-xl text-xs transition shadow-lg flex items-center justify-center gap-2 active:scale-95">
                        <i data-lucide="gem" class="w-4 h-4"></i> شراء جواهر وتطوير فوري
                    </button>
                </div>
            </div>

            <!-- Combat Logs Box -->
            <div class="bg-[#090D16] neon-border p-4 rounded-2xl">
                <p class="text-white font-bold text-xs mb-2 flex items-center gap-2">
                    <i data-lucide="radio" class="w-4 h-4 text-cyan-400"></i> سجل القيادة والعمليات:
                </p>
                <div id="combat-logs" class="space-y-1 text-xs text-cyan-300/80 max-h-28 overflow-y-auto pr-2">
                    <p class="border-b border-cyan-950 pb-1">[00:00] نظام الدفاع الاستراتيجي متصل ويعمل بكفاءة.</p>
                </div>
            </div>
        </section>

        <!-- Upgrades & Buildings Panel -->
        <section id="view-upgrades" class="hidden lg:col-span-4 bg-[#090D16] neon-border p-5 rounded-3xl flex flex-col gap-4">
            <h2 class="text-sm font-black text-white border-b border-cyan-500/20 pb-3 flex items-center gap-2">
                <i data-lucide="cpu" class="w-4 h-4 text-cyan-400"></i> ترقية منشآت الدفاع
            </h2>
            <div class="space-y-3">
                <div class="bg-black/50 neon-border p-4 rounded-2xl flex flex-col gap-3">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-white font-bold text-xs">مدفع البرق السيبراني</p>
                            <p id="up-lvl-core" class="text-[11px] text-cyan-400/70 mt-0.5">المستوى الحالي: 1</p>
                        </div>
                        <span class="text-xs bg-yellow-500/20 text-yellow-300 px-2.5 py-1 rounded-lg font-bold">400 فلكس</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2 mt-1">
                        <button onclick="upgradeFacility('core', 400)" class="bg-cyan-500 hover:bg-cyan-400 text-black py-2 rounded-xl font-bold text-xs transition">ترقية عادية</button>
                        <button onclick="instantUpgradeWithGems('مدفع البرق', 50)" class="bg-purple-600 hover:bg-purple-500 text-white py-2 rounded-xl font-bold text-xs transition flex items-center justify-center gap-1"><i data-lucide="gem" class="w-3 h-3"></i> 50 جوهرة</button>
                    </div>
                </div>
                <div class="bg-black/50 neon-border p-4 rounded-2xl flex flex-col gap-3">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-white font-bold text-xs">حصن الميناء الحصين</p>
                            <p id="up-lvl-vls" class="text-[11px] text-cyan-400/70 mt-0.5">المستوى الحالي: 1</p>
                        </div>
                        <span class="text-xs bg-yellow-500/20 text-yellow-300 px-2.5 py-1 rounded-lg font-bold">350 فلكس</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2 mt-1">
                        <button onclick="upgradeFacility('vls', 350)" class="bg-cyan-500 hover:bg-cyan-400 text-black py-2 rounded-xl font-bold text-xs transition">ترقية عادية</button>
                        <button onclick="instantUpgradeWithGems('حصن الميناء', 40)" class="bg-purple-600 hover:bg-purple-500 text-white py-2 rounded-xl font-bold text-xs transition flex items-center justify-center gap-1"><i data-lucide="gem" class="w-3 h-3"></i> 40 جوهرة</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Store Panel -->
        <section id="view-store" class="hidden lg:col-span-4 bg-[#090D16] border border-purple-500/40 p-5 rounded-3xl flex flex-col gap-4">
            <h2 class="text-sm font-black text-white border-b border-purple-500/20 pb-3 flex items-center gap-2">
                <i data-lucide="gift" class="w-4 h-4 text-purple-400"></i> متجر الجواهر الفوري
            </h2>
            <div class="space-y-3">
                <div class="bg-black/50 border border-purple-500/30 p-4 rounded-2xl text-center space-y-3">
                    <i data-lucide="zap" class="w-8 h-8 text-yellow-400 mx-auto animate-pulse"></i>
                    <div>
                        <p class="text-white font-bold text-xs">حزمة الفلكس السريعة</p>
                        <p class="text-[11px] text-purple-300 mt-0.5">تحويل 100 جوهرة مقابل 500 طاقة فلكس</p>
                    </div>
                    <button onclick="exchangeGemsForFlux(100, 500)" class="w-full bg-purple-600 hover:bg-purple-500 text-white py-2.5 rounded-xl font-bold text-xs transition shadow-md">شراء فلكس بالجواهر</button>
                </div>
                <div class="bg-black/50 border border-purple-500/30 p-4 rounded-2xl text-center space-y-3">
                    <i data-lucide="award" class="w-8 h-8 text-cyan-400 mx-auto animate-pulse"></i>
                    <div>
                        <p class="text-white font-bold text-xs">المنحة الملكية اليومية</p>
                        <p class="text-[11px] text-cyan-300 mt-0.5">+500 جوهرة مجانية لدعم الميناء</p>
                    </div>
                    <button onclick="claimDailyGems(500)" class="w-full bg-cyan-500 hover:bg-cyan-400 text-black py-2.5 rounded-xl font-bold text-xs transition shadow-md">استلام الهدية اليومية</button>
                </div>
            </div>
        </section>

    </main>

    <!-- Script Logic -->
    <script>
        lucide.createIcons();

        let flux = 1500;
        let gems = 3500;
        let soundEnabled = true;
        let upgradeLevels = { core: 1, vls: 1 };

        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(type) {
            if (!soundEnabled) return;
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            if (type === 'click') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(300, audioCtx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
                osc.start(); osc.stop(audioCtx.currentTime + 0.08);
            } else if (type === 'victory') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(300, audioCtx.currentTime);
                osc.frequency.setValueAtTime(450, audioCtx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                osc.start(); osc.stop(audioCtx.currentTime + 0.3);
            }
        }

        function toggleAudio() {
            soundEnabled = !soundEnabled;
            const btn = document.getElementById('audio-btn');
            btn.innerHTML = soundEnabled ? '<i data-lucide="volume-2" class="w-5 h-5 text-cyan-400"></i>' : '<i data-lucide="volume-x" class="w-5 h-5 text-red-400"></i>';
            lucide.createIcons();
            playSound('click');
        }

        function switchTab(tab) {
            playSound('click');
            ['game', 'upgrades', 'store'].forEach(t => {
                const el = document.getElementById(`view-${t}`);
                if(el) el.classList.add('hidden');
                const btn = document.getElementById(`tab-${t}`);
                if(btn) btn.className = "px-5 py-2.5 rounded-xl font-bold text-xs bg-[#090D16] text-cyan-400 neon-border hover:bg-cyan-500/10 transition flex items-center gap-2";
            });
            const targetView = document.getElementById(`view-${tab}`);
            if(targetView) {
                targetView.classList.remove('hidden');
                if(tab === 'game') targetView.classList.add('flex');
            }
            const targetBtn = document.getElementById(`tab-${tab}`);
            if(targetBtn) {
                targetBtn.className = tab === 'store' 
                    ? "px-5 py-2.5 rounded-xl font-bold text-xs bg-purple-600 text-white shadow-lg shadow-purple-600/20 transition flex items-center gap-2"
                    : "px-5 py-2.5 rounded-xl font-bold text-xs bg-cyan-500 text-black shadow-lg shadow-cyan-500/20 transition flex items-center gap-2";
            }
        }

        function triggerStrike(name) {
            playSound('click');
            const cost = 150;
            if (flux >= cost) {
                flux -= cost;
                document.getElementById('flux-count').innerText = flux;
                const logs = document.getElementById('combat-logs');
                logs.innerHTML = `<p class="border-b border-cyan-950 pb-1 text-cyan-200">إطلاق ${name} بنجاح وتدمير سفن العدو!</p>` + logs.innerHTML;
            } else {
                alert('طاقة الفلكس غير كافية!');
            }
        }

        function upgradeFacility(type, cost) {
            playSound('click');
            if (flux >= cost) {
                flux -= cost;
                upgradeLevels[type]++;
                document.getElementById('flux-count').innerText = flux;
                document.getElementById(`up-lvl-${type}`).innerText = `المستوى الحالي: ${upgradeLevels[type]}`;
                alert(`تمت ترقية المنشأة بنجاح بالموارد العادية!`);
            } else {
                alert('رصيد الفلكس غير كافٍ. استخدم الجواهر للتطوير الفوري!');
            }
        }

        function instantUpgradeWithGems(name, gemCost) {
            playSound('victory');
            if (gems >= gemCost) {
                gems -= gemCost;
                document.getElementById('gem-count').innerText = gems;
                alert(`⚡ تم إتمام ترقية "${name}" فوراً باستخدام الجواهر بنجاح!`);
            } else {
                alert('رصيد الجواهر غير كافٍ!');
            }
        }

        function exchangeGemsForFlux(gCost, fGain) {
            playSound('victory');
            if (gems >= gCost) {
                gems -= gCost;
                flux += fGain;
                document.getElementById('gem-count').innerText = gems;
                document.getElementById('flux-count').innerText = flux;
                alert(`تم استبدال ${gCost} جوهرة بنجاح وحصلت على ${fGain} طاقة فلكس!`);
            } else {
                alert('رصيد الجواهر لا يكفي للتحويل!');
            }
        }

        function claimDailyGems(amount) {
            playSound('victory');
            gems += amount;
            document.getElementById('gem-count').innerText = gems;
            alert(`تم إضافة ${amount} جوهرة ملكية لحسابك بنجاح!`);
        }
    </script>
</body>
</html>
