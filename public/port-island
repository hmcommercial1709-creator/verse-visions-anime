    <!-- Script Logic -->
    <script>
        lucide.createIcons();

        let flux = 1500;
        let gems = 3500;
        let soundEnabled = true;
        let upgradeLevels = { core: 1, vls: 1 };

        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(type) {
            if (!soundEnabled) return;
            if (audioCtx.state === 'suspended') audioCtx.resume();
            
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (type === 'click') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(300, audioCtx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
                osc.start(); osc.stop(audioCtx.currentTime + 0.08);
            } else if (type === 'victory') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(300, audioCtx.currentTime);
                osc.frequency.setValueAtTime(450, audioCtx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
                osc.start(); osc.stop(audioCtx.currentTime + 0.4);
            }
        }

        function toggleAudio() {
            soundEnabled = !soundEnabled;
            const btn = document.getElementById('audio-btn');
            btn.innerHTML = soundEnabled ? '<i data-lucide="volume-2" class="w-5 h-5 text-cyan-400"></i>' : '<i data-lucide="volume-x" class="w-5 h-5 text-red-400"></i>';
            lucide.createIcons();
            playSound('click');
        }

        function switchTab(tab) {
            playSound('click');
            ['game', 'upgrades', 'store'].forEach(t => {
                document.getElementById(`view-${t}`).classList.add('hidden');
                document.getElementById(`tab-${t}`).className = "px-4 py-2 rounded-xl font-bold text-xs bg-[#0B162C] text-cyan-400 border border-cyan-500/30 hover:bg-cyan-500/10 transition flex items-center gap-2";
            });
            document.getElementById(`view-${tab}`).classList.remove('hidden');
            document.getElementById(`tab-${tab}`).className = "px-4 py-2 rounded-xl font-bold text-xs bg-cyan-500 text-black shadow-lg transition flex items-center gap-2";
            if(tab === 'game') document.getElementById('view-game').className = "contents";
        }

        function triggerStrike(name) {
            playSound('click');
            const cost = 150;
            if (flux >= cost) {
                flux -= cost;
                document.getElementById('flux-count').innerText = flux;
                const logs = document.getElementById('combat-logs');
                logs.innerHTML = `<p class="border-b border-cyan-950 pb-1 text-cyan-200">إطلاق ${name} بنجاح!</p>` + logs.innerHTML;
            } else {
                alert('طاقة الفلكس غير كافية!');
            }
        }

        function upgradeFacility(type, cost) {
            playSound('click');
            if (flux >= cost) {
                flux -= cost;
                upgradeLevels[type]++;
                document.getElementById('flux-count').innerText = flux;
                document.getElementById(`up-lvl-${type}`).innerText = `المستوى الحالي: ${upgradeLevels[type]}`;
                alert(`تمت ترقية المنشأة بنجاح بالموارد العادية!`);
            } else {
                alert('رصيد الفلكس غير كافٍ. يمكنك استخدام الجواهر للتطوير الفوري!');
            }
        }

        function instantUpgradeWithGems(name, gemCost) {
            playSound('victory');
            if (gems >= gemCost) {
                gems -= gemCost;
                document.getElementById('gem-count').innerText = gems;
                alert(`⚡ تم إتمام ترقية "${name}" فوراً باستخدام الجواهر بنجاح!`);
            } else {
                alert('رصيد الجواهر غير كافٍ!');
            }
        }

        function exchangeGemsForFlux(gCost, fGain) {
            playSound('victory');
            if (gems >= gCost) {
                gems -= gCost;
                flux += fGain;
                document.getElementById('gem-count').innerText = gems;
                document.getElementById('flux-count').innerText = flux;
                alert(`تم استبدال ${gCost} جوهرة بنجاح وحصلت على ${fGain} طاقة فلكس!`);
            } else {
                alert('رصيد الجواهر لا يكفي للتحويل!');
            }
        }

        function claimDailyGems(amount) {
            playSound('victory');
            gems += amount;
            document.getElementById('gem-count').innerText = gems;
            alert(`تم إضافة ${amount} جوهرة ملكية لحسابك بنجاح!`);
        }

        function shareVictoryRaid() {
            playSound('victory');
            const raidCode = "GC-RAID-" + Math.floor(Math.random() * 89999 + 10000);
            const shareText = `🔥 معركة حية على Game Castle! كود الغارة: ${raidCode} - العب الآن وتحدى أسطولي!`;
            navigator.clipboard?.writeText(shareText);
            alert(`📋 تم نسخ رابط الغارة والتحدي:\n\n${shareText}`);
        }
    </script>
